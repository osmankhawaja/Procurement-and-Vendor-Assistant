# Google AI Studio
GOOGLE_API_KEY=your_google_ai_api_key

# Gemini models
PRIMARY_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# LangSmith tracing (modern names; LANGCHAIN_* names remain supported)
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ai-powered-procurement

# FastAPI server
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
CORS_ORIGINS=http://localhost:5173

# LangGraph state and agent limits
LANGGRAPH_CHECKPOINT_DB_PATH=./backend/data/langgraph_checkpoints.sqlite
RECURSION_LIMIT=8

# ERP and local storage
ERP_DATABASE_PATH=./backend/data/erp_database.sqlite
ERP_DATABASE_URL=sqlite:///./backend/data/erp_database.sqlite

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6MDEyYjE2ODItMDE1NS00ZWEwLTg4MTMtNWZmZTg0MDJiN2Y3In0.zIYOoz662AAmC1HkAaPYNJvbwR0vNXlQuGHrxH8XzZM
QDRANT_COLLECTION=procurement_policies

# Procurement policy and guardrails
HITL_APPROVAL_THRESHOLD=500
RAG_TOP_K=5
RAG_MIN_CONFIDENCE=0.72
